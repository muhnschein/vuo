# Rust
/target/
**/target/
*.pdb

# Cargo vendoring (scripts/vendor-crates.sh, offline OBS builds)
/vendor/
# All of .cargo/ except shared setting (.cargo/config.toml). Vendored build
# writes its own over it.
/.cargo/*
!/.cargo/config.toml

# Sailfish SDK / RPM build output
/RPMS/
/SRPMS/
/BUILD/
/BUILDROOT/
*.rpm

# Fonts from scripts/render-store-cover.sh. Not ours to redistribute; rendered
# store/cover.png is tracked.
/.fonts/

# SonarQube scanner workdir (see sonar-project.properties). Reports live under
# target/, ignored above.
/.scannerwork/

# insta snapshot review leftovers
*.snap.new

# cargo-fuzz
/crates/vuo-core/fuzz/target/
/crates/vuo-core/fuzz/corpus/
/crates/vuo-core/fuzz/artifacts/

# Editors / OS
*.swp
*~
.DS_Store
/.idea/
/.vscode/

# Local secrets for opt-in live integration test
.env

# Local reference checkouts of other projects, study only. GPL third-party code;
# never part of this tree.
/fuoten/
/sm/
/reference/

# Cross-built RPMs staged for device test, not committed.
/dist/
