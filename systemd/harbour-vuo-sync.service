# Periodic background refresh.
#
# Runs the same vuo-core sync engine the UI uses (§5: background refresh shares
# vuo-core rather than reimplementing sync in a script). A separate process
# rather than an in-app timer, because Sailfish suspends applications
# aggressively and a suspended app's timer does not fire.
[Unit]
Description=Vuo background feed sync
# Pointless without a network, and the sync engine's retry classifier should
# not have to distinguish "offline" from "server down".
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/harbour-vuo --sync-once
# Failing to reach the server is normal on a phone, not a fault worth
# restarting or logging loudly about.
SuccessExitStatus=0 75
Nice=10
IOSchedulingClass=idle
