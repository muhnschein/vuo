[Unit]
Description=Vuo background feed sync timer

[Timer]
# Not a fixed wall-clock schedule: every device would then wake at the same
# instant and hit the user's server together.
OnBootSec=5min
# The FINEST interval the Settings page offers, not the chosen one. The app
# runs sandboxed and cannot write a systemd drop-in, so the interval the
# user picked is applied by the service itself: harbour-vuo --sync-once
# reads it from the account file and does nothing when the last sync is
# too recent, or when the choice is "Manual only". A run that decides to do
# nothing is a process start and one file read.
OnUnitActiveSec=15min
# Spread across a window so repeated wakeups do not align with other timers,
# which is what turns a periodic sync into a battery complaint.
RandomizedDelaySec=2min
# If the phone was suspended through a scheduled run, do it on wake rather
# than skipping until the next interval.
Persistent=true

[Install]
WantedBy=timers.target
