[Desktop Entry]
Type=Application
Version=1.0
Name=Vuo
Comment=Miniflux feed reader
Icon=harbour-vuo
Exec=harbour-vuo
Terminal=false
Categories=Qt;Network;News;

# Sailfish: QML booster = no cold Qt init each start. Single instance: shared
# link reuses running app, no second copy.
X-Nemo-Application-Type=silica-qt5
X-Nemo-Single-Instance=yes

# Sandboxed, only what it uses. App writes only under dir these names give
# (~/.local/share/harbour-vuo/harbour-vuo; see AppPaths::resolve in
# crates/vuo-shim/src/worker.rs). Internet = Miniflux server; WebView = Gecko
# view on site page. Nothing else: one process (Harbour rule), syncs itself
# while running.
[X-Sailjail]
Permissions=Internet;WebView
OrganizationName=harbour-vuo
ApplicationName=harbour-vuo
