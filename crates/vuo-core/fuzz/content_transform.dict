# Tag and attribute shapes transform branches on. Saves fuzzer discovering angle
# brackets.
"<p>"
"</p>"
"<div>"
"<span>"
"<br>"
"<hr>"
"<h1>"
"<h2>"
"<h3>"
"<blockquote>"
"</blockquote>"
"<ul>"
"<ol>"
"<li>"
"</li>"
"<table>"
"<tr>"
"<td>"
"<th>"
"<pre>"
"<code>"
"<b>"
"<i>"
"<em>"
"<strong>"
"<sup>"
"<sub>"
"<figure>"
"<figcaption>"
# Elements transform must drop entirely.
"<script>"
"<style>"
"<svg>"
"<iframe>"
"<object>"
"<embed>"
"<meta>"
"<input>"
# Attributes and URL shapes: only http(s) may survive into link or image.
"href=\""
"src=\""
"alt=\""
"https://e.example/"
"http://e.example/"
"javascript:"
"data:image/png;base64,"
# Entities, to exercise escaping paths.
"&lt;"
"&gt;"
"&amp;"
"&quot;"
"&#x27;"
