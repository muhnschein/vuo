"entries"
"entry_ids"
"id"
"user_id"
"feed_id"
"status"
"hash"
"title"
"url"
"comments_url"
"language"
"published_at"
"created_at"
"changed_at"
"content"
"author"
"share_code"
"starred"
"reading_time"
"enclosures"
"tags"
"feed"
"category"
"icon"
"icon_id"
"mime_type"
"data"
"site_url"
"feed_url"
"checked_at"
"parsing_error_count"
"disabled"
# Status values, including the one only a pre-2.3 server sends.
"unread"
"read"
"removed"
# Schemes the domain types must refuse, and the two they must accept.
"javascript:"
"data:"
"file:"
"http://"
"https://"
# A well-formed timestamp, so mutations explore around a parseable one.
"2026-01-02T03:04:05Z"
"+02:00"
